KSCL-EXPERIMENTAL/0.1

current_id: KOS-COMM-CURRENT
repository: rgaricano/KOS-Lab
branch: KOS-Comn
language: es

architectural_state:
  gate_0: PASS
  reconciliation: CLOSED
  ar_1: CLOSED_PASS
  ar_2: CLOSED_PASS
  ar_3: ACTIVE_ADVERSARIAL_PASS_2_COMPLETE
  gate_a: PENDING

active_item:
  id: AR-3
  name: Modelo de Binding / Binding Model
  position: adversarial pass 2 complete; closure assessment pending

invariants:
  - KOS-Lab authority preserved
  - KOS-Comm autonomy preserved
  - Binding = explicit bilateral semantic seam
  - bilateral != symmetric or reversible
  - mapping capability != domain authority
  - candidate != accepted domain state
  - receipt != canonical import
  - identity mapping != identity authority
  - degradation cannot be silently elevated
  - property strength may increase only with new independent explicit scoped justification/evidence
  - Binding policy = mapping admissibility; Domain policy = authoritative acceptance/action
  - declared compatibility != runtime mappability
  - Binding composition safety must be validated, not assumed
  - correlation conflict must remain explicit unless resolved by declared scope/basis
  - binding identity unique within declared interoperability scope
  - KCA = neutral target
  - KCP = small and replaceable
  - KSCL = experimental/open decomposition
  - reconstruction != authorization

ar_3_evidence:
  initial_model: COMPLETE
  validation_pass_1:
    cases: 12
    passed: 12
    critical_contradictions: 0
  adversarial_pass_2:
    cases: 8
    passed: 8
    critical_contradictions: 0
    core_rework: false
    closure_candidate: true

ar_3_stabilized_refinements:
  binding_identity: required for interoperable BindingContract and unique within declared scope
  status_reason_separation: true
  correlation_conflict: explicit, no silent resolution
  correlation_persistence: not necessarily owned by Binding
  policy_boundary: mapping admissibility at Binding; authoritative acceptance/action at Domain
  compatibility_levels:
    - DECLARED_CONTRACT_COMPATIBILITY
    - RUNTIME_SEMANTIC_MAPPABILITY
  composition: explicit assessment required
  restoration: only with new independent explicit scoped justification/evidence
  lifecycle: management/governance metadata, not core invariant

working_documents:
  - docs/kos-comn/architecture/AR-1-CLOSURE.es.md
  - docs/kos-comn/architecture/AR-1-CLOSURE.en.md
  - docs/kos-comn/architecture/AR-2-CLOSURE.es.md
  - docs/kos-comn/architecture/AR-2-CLOSURE.en.md
  - docs/kos-comn/architecture/AR-3-BINDING-MODEL.es.md
  - docs/kos-comn/architecture/AR-3-BINDING-MODEL.en.md
  - docs/kos-comn/architecture/AR-3-BINDING-VALIDATION.es.md
  - docs/kos-comn/architecture/AR-3-BINDING-VALIDATION.en.md
  - docs/kos-comn/architecture/AR-3-BINDING-ADVERSARIAL.es.md
  - docs/kos-comn/architecture/AR-3-BINDING-ADVERSARIAL.en.md

next_action:
  id: AR-3-CLOSURE-ASSESSMENT
  description_es: Revisar criterios finales, producir cierre bilingüe de AR-3 si procede y preparar evaluación de Gate A.
  description_en: Review final criteria, produce bilingual AR-3 closure if appropriate, and prepare Gate A assessment.
  decision_target: CLOSE_AR_3_OR_REWORK

closure_checks:
  - explicit bilateral seam preserved
  - authority separation preserved
  - AR-1 property transitions preserved
  - AR-2 criticality/degradation preserved
  - identity and correlation semantics bounded
  - compatibility and runtime mappability separated
  - composition explicitly assessed
  - policy boundary preserved
  - non-KOS realization feasible
  - encoding and transport remain out of AR-3

reentry_rule:
  - verify actual Git HEAD before development
  - reconcile CURRENT.kscl against later commits/documents
  - do not infer authority from this record

assertions:
  - CURRENT.kscl is mutable continuity state
  - checkpoint is historical snapshot
  - KSCL continuity != architectural authority
  - KSCL reconstruction != proof
