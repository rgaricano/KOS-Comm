current_id: KOS-COMM-CURRENT
repository: rgaricano/KOS-Lab
branch: KOS-Comn
language: es

architectural_state:
  gate_0: PASS
  reconciliation: CLOSED
  ar_1: CLOSED_PASS
  ar_2: CLOSED_PASS
  ar_3: NEXT
  gate_a: PENDING

active_item:
  id: AR-3
  name: Modelo de Binding / Binding Model
  position: ready to start

invariants:
  - KOS-Lab authority preserved
  - KOS-Comm autonomy preserved
  - Binding = bilateral seam
  - KCA = neutral target
  - KCP = small and replaceable
  - KSCL = experimental/open decomposition
  - receipt != canonical import
  - communication != authority
  - representation != represented object
  - representation != authority
  - reconstruction != authorization
  - promotion = evidence + governance

closed_items:
  - Gate 0 architectural consensus
  - KOS-Lab <-> KOS-Comm reconciliation
  - AR-1 Boundary Model
  - AR-2 Representation Model

ar_2_closure:
  formula: MINIMAL_SEMANTIC_CORE + DECLARED_SEMANTIC_CAPABILITIES + OPTIONAL_EXTENSIBLE_CLASSIFICATION
  mandatory_core:
    - subject
    - semantic_context
    - capabilities
    - content
  conditional_core:
    - representation_identity
    - provenance
    - classification
  capability_criticality:
    - REQUIRED_FOR_INTERPRETATION
    - REQUIRED_FOR_DECLARED_PROPERTY
    - OPTIONAL
    - INFORMATIONAL
  interpretation_states:
    - FULL
    - DEGRADED
    - UNINTERPRETABLE
  final_review:
    adversarial_cases: 7
    passed: 7
    critical_contradictions: 0

