KSCL-EXPERIMENTAL/0.1

current_id: KOS-COMM-CURRENT
repository: rgaricano/KOS-Lab
branch: KOS-Comn
language: es

architectural_state:
  gate_0: PASS
  reconciliation: CLOSED
  ar_1: CLOSED_PASS
  ar_2: CLOSED_PASS
  ar_3: ACTIVE_INITIAL_MODEL_ESTABLISHED
  gate_a: PENDING

active_item:
  id: AR-3
  name: Modelo de Binding / Binding Model
  position: initial model established; validation pass 1 pending

invariants:
  - KOS-Lab authority preserved
  - KOS-Comm autonomy preserved
  - Binding = explicit bilateral semantic seam
  - bilateral != symmetric or reversible
  - mapping capability != domain authority
  - candidate != accepted domain state
  - receipt != canonical import
  - identity mapping != identity authority
  - degradation cannot be silently elevated
  - KCA = neutral target
  - KCP = small and replaceable
  - KSCL = experimental/open decomposition
  - representation != represented object
  - reconstruction != authorization
  - promotion = evidence + governance

closed_items:
  - Gate 0 architectural consensus
  - KOS-Lab <-> KOS-Comm reconciliation
  - AR-1 Boundary Model
  - AR-2 Representation Model

ar_3_initial_model:
  definition: explicit semantic adapter at domain/KCA boundary
  directions:
    - OUTBOUND
    - INBOUND
    - BIDIRECTIONAL
  mapping_status:
    - MAPPED
    - MAPPED_WITH_DEGRADATION
    - UNMAPPABLE
    - REJECTED_BY_BINDING_POLICY
    - UNSUPPORTED_CONTRACT
  capability_mapping:
    - SUPPORTED_NATIVE
    - SUPPORTED_MAPPED
    - SUPPORTED_WITH_DEGRADATION
    - UNSUPPORTED
    - NOT_APPLICABLE
  identity_correlations:
    - ONE_TO_ONE
    - ONE_TO_MANY
    - MANY_TO_ONE
    - CONTEXTUAL
    - UNRESOLVED

working_documents:
  - docs/kos-comn/architecture/AR-1-CLOSURE.es.md
  - docs/kos-comn/architecture/AR-1-CLOSURE.en.md
  - docs/kos-comn/architecture/AR-2-CLOSURE.es.md
  - docs/kos-comn/architecture/AR-2-CLOSURE.en.md
  - docs/kos-comn/architecture/AR-3-BINDING-MODEL.es.md
  - docs/kos-comn/architecture/AR-3-BINDING-MODEL.en.md

next_action:
  id: AR-3-VALIDATION-PASS-1
  description_es: Ejecutar los 12 casos iniciales del Modelo de Binding y refinar responsabilidades, compatibilidad, política y composición.
  description_en: Run the 12 initial Binding Model cases and refine responsibilities, compatibility, policy and composition.
  decision_target: AR-3 REFINED MODEL

validation_cases:
  - KOS to KCA partial observation
  - KCA to KOS received result without canonical import
  - non-KOS A to KCA to non-KOS B
  - local identity across namespaces
  - unsupported critical inbound capability
  - declared lossy outbound mapping
  - OUTBOUND-only Binding
  - bidirectional non-reversible Binding
  - incompatible contracts
  - local policy stricter than KCA
  - correlation without identity authority
  - two-Binding chain with accumulated degradation

open_focus:
  - mandatory vs conditional binding identity
  - local policy placement
  - mapping-rule dependencies
  - statically checkable compatibility
  - persistent correlation without authoritative storage
  - UNMAPPABLE vs INSUFFICIENT_INFORMATION
  - multi-Binding composition

reentry_rule:
  - verify actual Git HEAD before development
  - reconcile CURRENT.kscl against later commits/documents
  - do not infer authority from this record

assertions:
  - CURRENT.kscl is mutable continuity state
  - checkpoint is historical snapshot
  - KSCL continuity != architectural authority
  - KSCL reconstruction != proof
