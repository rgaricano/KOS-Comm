continuity:
  active_item:
    id: NS-2
    name: KSCL Semantic Constructs
    position: ready for consolidation and authority recheck under frozen NS-1
  next_action:
    id: NS-2-CONSOLIDATION
    description_es: Revisar NS-2…NS-7 bajo la autoridad documental ya fijada, sin reabrir NS-1 salvo incoherencia real.
    description_en: Review NS-2..NS-7 under the already fixed documentary authority, without reopening NS-1 unless a real inconsistency appears.

architecture_decisions:
  architecture_authority: ARCHITECTURE.kscl
  continuity_authority: CURRENT.kscl
  decision_registry: DECISIONS.kscl
  history_registry: HISTORY.kscl
  frozen_decisions:
    - identifier_grammar: KSCL-<SECTION>-<DOMAIN>-<NNN>
    - localization_model: one file per language, semantically equivalent, identifier-stable
    - glossary_authority: NS-0
    - core_authority: NS-1
    - construct_authority: NS-2
    - conformance_authority: NS-3
    - profiles_authority: NS-4
    - serialization_authority: NS-5
    - validation_authority: NS-6
    - governance_authority: NS-7

governance:
  session_focus: NS-1 consolidated; NS-2..NS-7 under review
  open_questions:
    - ensure REQ vs INV separation across NS family
    - confirm all identifier families remain consistent with frozen grammar
    - populate ARCHITECTURE.kscl, DECISIONS.kscl, HISTORY.kscl, ROADMAP.kscl
  reentry_rule:
    - verify actual Git HEAD before development
    - reconcile CURRENT.kscl against later commits/documents
    - do not infer authority from this record

references:
  architecture:
    - docs/kos-comn/architecture/AR-4-CLOSURE.en.md
    - docs/kos-comn/architecture/AR-5-CLOSURE.en.md
    - docs/kos-comn/architecture/GATE-B-ASSESSMENT.en.md
