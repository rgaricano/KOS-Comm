KSCL-EXPERIMENTAL/0.1

current_id: KOS-COMM-CURRENT
repository: rgaricano/KOS-Lab
branch: KOS-Comn
language: es

architectural_state:
  gate_0: PASS
  reconciliation: CLOSED
  phase_1: CLOSED
  ar_1: CLOSED_PASS
  ar_2: CLOSED_PASS
  ar_3: CLOSED_PASS
  gate_a: PASS
  phase_2: ACTIVE
  ar_4: ACTIVE_INITIAL_MODEL_ESTABLISHED
  ar_5: PENDING
  gate_b: PENDING

active_item:
  id: AR-4
  name: Modelo de Reconstrucción / Reconstruction Model
  position: initial model established; validation pass 1 next

invariants:
  - KOS-Lab authority preserved
  - KOS-Comm autonomy preserved
  - representation != represented object
  - reconstruction != inversion by default
  - reconstruction != authorization
  - reconstructed artifact != accepted/canonical domain state
  - Binding != Reconstruction
  - mapping capability != domain authority
  - candidate != accepted domain state
  - receipt != canonical import
  - identity evidence/correlation/claim != identity authority
  - fidelity claims are relative to explicit scope
  - unresolved ambiguity must remain explicit
  - partial reconstruction != failure by definition
  - property strength may increase only with new independent explicit scoped justification/evidence
  - provenance of reconstruction is composite when multiple sources/rules participate
  - historical reconstruction != current-state assertion
  - KCA = neutral core
  - KOS Binding = domain-specific realization, not neutral core
  - encoding remains outside reconstruction semantics
  - KCP remains outside reconstruction semantics
  - KSCL remains experimental/open decomposition pending AR-5

ar_4_initial_model:
  definition: represented information + context + evidence + rules -> reconstruction result
  candidate_classes:
    - EXACT
    - EQUIVALENT
    - PARTIAL
    - DEGRADED
    - AMBIGUOUS
    - IMPOSSIBLE
  result_fields:
    - status
    - artifact
    - candidates
    - target_scope
    - reconstructed_scope
    - fidelity
    - property_transitions
    - evidence_refs
    - provenance
    - diagnostics
  evidence_classes:
    - REPRESENTED_EVIDENCE
    - CONTEXTUAL_EVIDENCE
    - LOCAL_INDEPENDENT_EVIDENCE
    - DERIVED_EVIDENCE

working_documents:
  - docs/kos-comn/architecture/GATE-A-ASSESSMENT.es.md
  - docs/kos-comn/architecture/GATE-A-ASSESSMENT.en.md
  - docs/kos-comn/architecture/AR-4-RECONSTRUCTION-MODEL.es.md
  - docs/kos-comn/architecture/AR-4-RECONSTRUCTION-MODEL.en.md

next_action:
  id: AR-4-VALIDATION-PASS-1
  description_es: Validar el modelo inicial de reconstrucción mediante los doce casos previstos y resolver la relación entre estado, clase, alcance, fidelidad, ambigüedad y parcialidad.
  description_en: Validate the initial Reconstruction Model through the twelve planned cases and resolve the relationship among status, class, scope, fidelity, ambiguity and partiality.
  decision_target: AR-4 VALIDATION PASS 1

ar_4_open_questions:
  - status vs fidelity/reconstruction class
  - coexistence of PARTIAL and AMBIGUOUS
  - multiple candidate representation
  - DEGRADED vs PARTIAL
  - minimum ReconstructionScope
  - conflicting evidence semantics
  - explicit ReconstructionClaim
  - successive reconstruction composition
  - temporal/multi-state reconstruction
  - AR-5/KSCL consumption boundary

ar_4_validation_cases:
  - complete representation with equivalent reconstruction
  - partial representation with partial reconstruction
  - irreversible loss preventing required reconstruction
  - two equally compatible candidates
  - new local evidence restoring a property
  - conflicting evidence from two sources
  - correct reconstruction not authorized by domain
  - neutral reconstruction without Binding
  - reconstruction followed by Binding toward KOS
  - historical state reconstruction versus current state
  - reconstruction chain with accumulated degradation
  - target scope smaller than available information

phase_2_plan:
  - AR-4 Reconstruction Model
  - AR-5 KSCL Decomposition
  - Gate B

reopen_gate_a_if:
  - AR-4 requires incompatible reconstruction ownership transfer into AR-3
  - reconstruction requires fundamental AR-2 semantic change
  - AR-1 cannot express required property transitions
  - circular authority/dependency appears
  - conceptual non-KOS neutrality fails
  - encoding or transport becomes inseparable from Phase I semantic core

reentry_rule:
  - verify actual Git HEAD before development
  - reconcile CURRENT.kscl against later commits/documents
  - do not infer authority from this record

assertions:
  - CURRENT.kscl is mutable continuity state
  - checkpoint is historical snapshot
  - KSCL continuity != architectural authority
  - KSCL reconstruction != proof
  - Gate A PASS != KOS-Lab integration authorization
