branch: KOS-Comn
language: es

architectural_state:
  gate_0: PASS
  reconciliation: CLOSED
  phase_1: CLOSED
  ar_1: CLOSED_PASS
  ar_2: CLOSED_PASS
  ar_3: CLOSED_PASS
