validated_findings:
  - 12 initial AR-2 cases are modelable
  - rigid representation class taxonomy rejected as core
  - extensible classification retained
  - minimal common semantic core is candidate
  - semantic capabilities are primary candidate
  - RepresentationEnvelope remains logical reference model only
  - provenance capability is core but completeness may vary
  - COMPLETE requires declared scope
  - Claim, Evidence, Verification and Guarantee remain distinct
  - SubjectDescriptor must not require a universal global identifier

candidate_model:
  formula: MINIMAL_COMMON_CORE + SEMANTIC_CAPABILITIES + EXTENSIBLE_CLASSIFICATION
  core:
    - representation_identity
    - subject
    - semantic_context
    - provenance
    - capabilities
    - content
  capabilities:
    - SUBJECT_IDENTIFICATION
    - REFERENCE_SEMANTICS
    - PROVENANCE
    - DERIVATION
    - COVERAGE
    - TEMPORALITY
    - RELATIONSHIPS
    - COMPOSITION
    - PROPERTY_CLAIMS
    - EVIDENCE_LINKAGE
    - VERIFICATION_STATEMENTS
    - RECONSTRUCTION_INFORMATION

next_action:
  id: AR-2-REFINEMENT-PASS-2
  description_es: Refinar núcleo semántico mínimo, capacidades, SubjectDescriptor y semántica Claim/Evidence/Verification/Guarantee.
  description_en: Refine minimum semantic core, capabilities, SubjectDescriptor and Claim/Evidence/Verification/Guarantee semantics.
  decision_target: prepare AR-2 closure candidate

open_focus:
  - exact minimum-core membership
  - representation_identity requirement for ephemeral representations
  - safe capability extensibility and ignorability
  - minimum SubjectDescriptor semantics
  - formal Claim/Evidence/Verification/Guarantee relationships
  - neutral-core protection from domain extensions
  - complex degradation/composition validation

reentry_rule:
  - verify actual Git HEAD before development
  - reconcile CURRENT.kscl against later commits/documents
  - do not infer authority from this record

assertions:
  - CURRENT.kscl is mutable continuity state
  - checkpoint is historical snapshot
  - KSCL continuity != architectural authority
  - KSCL reconstruction != proof
